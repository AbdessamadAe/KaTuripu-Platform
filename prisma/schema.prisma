generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum NodeType {
  progressNode
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id               String                 @id @default(uuid())
  email            String                 @unique
  name             String?
  image            String?
  role             Role?                  @default(USER)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @map("updated_at")
  exerciseProgress UserExerciseProgress[]
  quizResults      UserQuizResult[]

  @@map("users")
}

model Roadmap {
  id          String        @id @default(uuid())
  title       String
  description String?
  category    String?
  imageUrl    String?       @map("image_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  nodes       RoadmapNode[]
  edges       RoadmapEdge[]
  duration    Int
  quiz        Quiz?

  @@map("roadmaps")
}

model RoadmapNode {
  id          String         @id @default(uuid())
  roadmapId   String         @map("roadmap_id")
  roadmap     Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  label       String
  description String?
  type        NodeType       @default(progressNode)
  positionX   Int?           @map("position_x")
  positionY   Int?           @map("position_y")
  edgesSource RoadmapEdge[]  @relation("sourceEdges")
  edgesTarget RoadmapEdge[]  @relation("targetEdges")
  exercises   NodeExercise[]

  @@map("roadmap_nodes")
  @@index([roadmapId])
}

model RoadmapEdge {
  id           String      @id @default(uuid())
  roadmapId    String      @map("roadmap_id")
  roadmap      Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sourceNodeId String      @map("source_node_id")
  sourceNode   RoadmapNode @relation("sourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String      @map("target_node_id")
  targetNode   RoadmapNode @relation("targetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@map("roadmap_edges")
  @@index([roadmapId])
}

model Exercise {
  id              String            @id @default(uuid())
  name            String
  description     String?
  choices         String[]
  correctAnswer   Int               //index of correctAnswer
  explanation     String?
  difficulty      ExerciseDifficulty
  hints           String[]
  videoUrl        String?           @map("video_url")
  questionImageUrl String?          @map("question_image_url")
  isActive        Boolean           @default(true) @map("is_active")
  nodeExercises   NodeExercise[]
  quizQuestions   QuizQuestion[]
  userProgress    UserExerciseProgress[]

  @@map("exercises")
}

model NodeExercise {
  nodeId     String      @map("node_id")
  node       RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  exerciseId String      @map("exercise_id")
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  orderIndex Int?        @map("order_index")

  @@id([nodeId, exerciseId])
  @@map("node_exercises")
  @@index([nodeId])
  @@index([exerciseId])
}

model UserExerciseProgress {
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String    @map("exercise_id")
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  @@id([userId, exerciseId])
  @@map("user_exercise_progress")
  @@index([userId])
  @@index([exerciseId])
}

model Quiz {
  id        String           @id @default(uuid())
  roadmapId String           @unique @map("roadmap_id")
  roadmap   Roadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title     String
  questions QuizQuestion[]
  createdAt DateTime         @default(now()) @map("created_at")
  results   UserQuizResult[]

  @@map("quizzes")
}

model QuizQuestion {
  id         String    @id @default(uuid())
  quizId     String    @map("quiz_id")
  quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  exerciseId String    @map("exercise_id")
  exercise   Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  orderIndex Int?

  @@map("quiz_questions")
  @@index([quizId])
  @@index([exerciseId])
}

model UserQuizResult {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  quizId      String   @map("quiz_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int
  completedAt DateTime @default(now()) @map("completed_at")

  @@unique([userId, quizId])
  @@map("user_quiz_results")
  @@index([userId])
  @@index([quizId])
}